#!/bin/bash
# cu118.env — sourceable env file for BundleSDF CUDA 11.8 container.
# Sourced automatically by entrypoint.sh and from /root/.bashrc.
# Can also be sourced manually inside the container:
#   source /etc/cu118.env

# ============================================================
# Display / X11
# ============================================================
export DISPLAY=${DISPLAY:-:0}
export QT_X11_NO_MITSHM=1

# ============================================================
# CUDA
# ============================================================
export CUDA_HOME=/usr/local/cuda
export CUDA_PATH=/usr/local/cuda
export CUDA_TOOLKIT_ROOT_DIR=/usr/local/cuda
export PATH=/usr/local/cuda/bin:${PATH}
export LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

# PyTorch lib path (system Python 3.10)
export LD_LIBRARY_PATH=/usr/local/lib/python3.10/dist-packages/torch/lib:${LD_LIBRARY_PATH}

# ============================================================
# BundleSDF build env
# ============================================================
export FORCE_CUDA=1
export TORCH_CUDA_ARCH_LIST="7.0;7.5;8.0;8.6;8.9"
export TORCH_EXTENSIONS_DIR=/tmp/torch_extensions
export PYTHONPATH=/workspace/BundleSDF:${PYTHONPATH}
export OPENCV_IO_ENABLE_OPENEXR=1
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=1

# ============================================================
# Interactive summary
# ============================================================
if [ -t 0 ]; then
    echo ""
    echo "============================================================"
    echo "BundleSDF — CUDA 11.8"
    echo "============================================================"
    echo "CUDA_HOME           : ${CUDA_HOME}"
    echo "TORCH_CUDA_ARCH_LIST: ${TORCH_CUDA_ARCH_LIST}"
    if command -v python3 >/dev/null 2>&1; then
        echo "Python              : $(python3 --version 2>&1)"
    fi
    echo "============================================================"
    echo ""
    echo "First run (builds mycuda + BundleTrack automatically):"
    echo "  docker compose -f docker/docker-compose.yaml up -d"
    echo "  docker exec -it bundlesdf bash"
    echo ""
    echo "Manual build:"
    echo "  cd /workspace/BundleSDF && bash build.sh"
    echo ""
    echo "Run custom RGBD video:"
    echo "  python3 run_custom.py --mode run_video --video_dir <path> --out_folder <path>"
    echo "============================================================"
    echo ""
fi
