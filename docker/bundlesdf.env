#!/bin/bash
# bundlesdf.env — sourceable env file for the BundleSDF container.
# Stack: NVIDIA DeepStream 7.1 base (CUDA 12.x) + PyTorch 2.6, system Python 3.10.
# Sourced automatically by entrypoint.sh (main process) and from /root/.bashrc
# (interactive `docker exec` shells). Can also be sourced manually:
#   source /etc/bundlesdf.env

# ============================================================
# Display / X11
# ============================================================
export DISPLAY=${DISPLAY:-:0}
export QT_X11_NO_MITSHM=1

# ============================================================
# CUDA
# ============================================================
export CUDA_HOME=/usr/local/cuda
export CUDA_PATH=/usr/local/cuda
export CUDA_TOOLKIT_ROOT_DIR=/usr/local/cuda
export PATH=/usr/local/cuda/bin:${PATH}
export LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

# PyTorch lib path (system Python 3.10)
export LD_LIBRARY_PATH=/usr/local/lib/python3.10/dist-packages/torch/lib:${LD_LIBRARY_PATH}

# ============================================================
# BundleSDF build env
# ============================================================
export FORCE_CUDA=1
export TORCH_CUDA_ARCH_LIST="7.0;7.5;8.0;8.6;8.9;9.0"
export TORCH_EXTENSIONS_DIR=/tmp/torch_extensions
export PYTHONPATH=/workspace/BundleSDF:${PYTHONPATH}
export OPENCV_IO_ENABLE_OPENEXR=1
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=1

# ============================================================
# Interactive summary (one concise line; this is sourced on every interactive shell)
# ============================================================
if [ -t 0 ]; then
    echo "[BundleSDF] DeepStream 7.1 / CUDA 12.x / PyTorch 2.6  |  cwd=$(pwd)  |  build: bash build.sh"
fi
